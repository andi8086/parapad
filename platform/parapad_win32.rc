#include "version.h"

#define DS_MODALFRAME    0x80L
#define WS_CAPTION       0x00C00000L
#define WS_SYSMENU       0x00080000L

#define SS_BLACKFRAME    0x00000007L

#include "resource_win32.h"

#define IDOK             1

IDI_ICON_MAIN ICON "parapad_win32.ico"

IDD_ABOUT DIALOG 30, 30, 200, 100
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About ParaPad"
FONT 8, "MS Sans Serif"
BEGIN
        ICON    IDI_ICON_MAIN, -1, 10, 10, 0, 0
        LTEXT   "ParaPad", -1, 40, 10, 130, 8
        LTEXT   VERSION_STR, -1, 40, 20, 130, 8
        LTEXT   COPYRIGHT_STR, -1, 40, 30, 130, 8

        CONTROL "", -1, "Static", SS_BLACKFRAME, 10, 45, 180, 1

        LTEXT   "Memory:", -1, 10, 52, 50, 8
        LTEXT   "0 KB Free", IDC_PHYSICAL_MEM, 65, 52, 85, 8

        DEFPUSHBUTTON "OK", IDOK, 75, 80, 50, 14
END

